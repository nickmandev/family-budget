[Unit]
Description=Check for and deploy a Family Budget release (user %i)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=%i
SupplementaryGroups=docker
WorkingDirectory=/opt/family-budget
Environment=FAMILY_BUDGET_DIR=/opt/family-budget
ExecStart=/opt/family-budget/scripts/check-release.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

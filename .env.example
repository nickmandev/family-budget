# Copy this file to .env, replace every placeholder, then restrict it:
#
#   cp .env.example .env
#   chmod 600 .env
#
# Never commit .env or any file containing real secrets. See
# docs/SECURITY_AND_OPERATIONS.md and docs/DEPLOYMENT.md.
# The application variable names below are the exact names
# internal/config/config.go reads. The backup variables at the end are read only
# by scripts/backup.sh, scripts/restore.sh and scripts/verify-restore.sh.

# --- PostgreSQL container -------------------------------------------------
POSTGRES_USER=family_budget
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=family_budget

# --- Application database DSN --------------------------------------------
# Host `db` is the compose service name. Port 5432 stays on the private
# `backend` network and is never published to the host.
# Percent-encode URL-special characters in the password
# (for example @ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL=postgres://family_budget:replace-with-a-long-random-password@db:5432/family_budget?sslmode=disable

# --- Public edge ----------------------------------------------------------
# DOMAIN must match the DNS record pointing at this VPS. Caddy obtains and
# renews the TLS certificate automatically. ACME_EMAIL receives expiry notices.
DOMAIN=budget.example.com
ACME_EMAIL=admin@example.com

# --- HTTP server ----------------------------------------------------------
PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576

# --- Authentication -------------------------------------------------------
# Re-benchmark Argon2id on the target VPS before raising or lowering these.
AUTH_ARGON2_TIME=3
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_THREADS=4
AUTH_ARGON2_KEY_LENGTH=32
AUTH_ARGON2_SALT_LENGTH=16
AUTH_SESSION_TTL=720h
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m

# --- Backups and restore (scripts/, not read by the API) ------------------
# See docs/RUNBOOK.md. Backups are pg_dump custom-format archives encrypted
# with age before they leave the VPS. The age private identity must NEVER be
# stored on the VPS; only the public recipient belongs here.
#
# Generate a keypair on the operator machine:
#   mkdir -p ~/.config/age && age-keygen -o ~/.config/age/family-budget.key
# Put the printed "public key: age1..." value below.
BACKUP_ENCRYPTION_PUBLIC_KEY=age1replacewiththepublicrecipient

# Off-host target: Hetzner Storage Box reached with rsync over SSH (port 23).
# Use the hostname/user from the Hetzner console; key-based auth only.
BACKUP_SSH_TARGET=u123456@u123456.your-storagebox.de
BACKUP_SSH_PORT=23
BACKUP_SSH_KEY=/root/.ssh/storagebox_ed25519
BACKUP_REMOTE_PATH=family-budget

# Retention. The scripts keep the newest artifacts by count.
BACKUP_KEEP_LOCAL=8
BACKUP_KEEP_REMOTE=28

# Restore only, on the operator machine (never on the VPS):
# BACKUP_AGE_IDENTITY_FILE=/home/operator/.config/age/family-budget.key

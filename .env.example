# Copy this file to .env, replace every placeholder, then restrict it:
#
#   cp .env.example .env
#   chmod 600 .env
#
# Never commit .env or any file containing real secrets. See
# docs/SECURITY_AND_OPERATIONS.md and docs/DEPLOYMENT.md.
# The application variable names below are the exact names
# internal/config/config.go reads.

# --- PostgreSQL connection ------------------------------------------------
# The database connection is supplied as separate components, never as a URL.
# The same variables configure the db container and the api/migrate services;
# the application constructs the connection string internally. Each value is
# defined exactly once here.
#
# POSTGRES_HOST is the compose service name for the in-stack database. Use
# 127.0.0.1 (or a real hostname) only when pointing at a database outside the
# compose stack. Port 5432 stays on the private `backend` network and is never
# published to the host.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=family_budget
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=family_budget
# sslmode `disable` is correct on the private internal `backend` network. Use
# `require`, `verify-ca` or `verify-full` when the database is reached over an
# untrusted link and the server presents a verifiable certificate.
POSTGRES_SSLMODE=disable

# --- Database connection pool (API) --------------------------------------
# Keep DATABASE_MAX_OPEN_CONNS below PostgreSQL's max_connections (25 in
# deploy/postgres/99-small-vps.conf) so migrations, the healthcheck and an
# operator psql session still fit. Idle connections are capped below the open
# limit; lifetimes keep stale connections from lingering on a small host.
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_CONN_MAX_IDLE_TIME=15m

# --- Public edge ----------------------------------------------------------
# The API is published on loopback only (127.0.0.1). The host's existing nginx
# terminates TLS with its Let's Encrypt certificate and proxies to it; see
# deploy/nginx/family-budget.conf. The public hostname lives in that nginx
# server block (server_name), not in this file.
#
# API_HOST_PORT is the loopback port nginx proxies to. Keep it in sync with the
# `proxy_pass` line in the nginx snippet.
API_HOST_PORT=8080

# --- HTTP server ----------------------------------------------------------
PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
# Comma-separated exact origins; empty disables CORS. No wildcards or trailing slash.
HTTP_CORS_ALLOWED_ORIGINS=https://budget.nickmandev.com
# Comma-separated CIDRs whose X-Forwarded-For / X-Real-IP headers are trusted.
# The default trusts loopback only: the host nginx (and Cloudflare in front of
# it) reach the API over 127.0.0.1, so the forwarded real client IP is safe to
# use. A direct caller cannot spoof the header. Only widen this if another
# trusted proxy sits in front of nginx.
HTTP_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# --- Go runtime (API container) -------------------------------------------
# GOMEMLIMIT stays below the api memory limit (256 MiB in compose.yaml) so the
# Go runtime collects before the container is OOM-killed. GOMAXPROCS matches
# the API's CPU budget rather than the whole shared host.
GOMEMLIMIT=192MiB
GOMAXPROCS=2

# --- Authentication -------------------------------------------------------
# Re-benchmark Argon2id on the target VPS before raising or lowering these.
AUTH_ARGON2_TIME=3
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_THREADS=4
AUTH_ARGON2_KEY_LENGTH=32
AUTH_ARGON2_SALT_LENGTH=16
AUTH_SESSION_TTL=720h
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m

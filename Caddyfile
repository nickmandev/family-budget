# Caddy terminates TLS for the API (PLATFORM_DECISIONS §F).
#
# Replace budget.example.com with the real domain in .env (DOMAIN). Caddy
# obtains and renews certificates automatically over ports 80/443; the domain's
# DNS A/AAAA record must point at this host before the first start.
#
# Local testing without public DNS: uncomment `local_certs` below (Caddy's
# internal CA) and use a self-signed certificate.

{
	email {$ACME_EMAIL:admin@example.com}
	# local_certs
}

{$DOMAIN:budget.example.com} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	reverse_proxy api:{$PORT:8080}
}

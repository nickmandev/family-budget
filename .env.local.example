# Template for local Enable Banking sandbox testing; never put real values here.
# The real .env.local is gitignored. Keep the provider key in secrets/.

# PostgreSQL container credentials and private-network connection.
POSTGRES_USER=family_budget
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=family_budget
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Loopback API port and local frontend CORS origin.
API_HOST_PORT=8080
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Enable Banking sandbox application and local consent callback/result pages.
ENABLEBANKING_ENABLED=true
# Paste the sandbox app UUID here.
ENABLEBANKING_APPLICATION_ID=
ENABLEBANKING_PRIVATE_KEY_FILE=/run/secrets/enablebanking.key
ENABLEBANKING_REDIRECT_URL=http://localhost:8080/callbacks/enablebanking
ENABLEBANKING_RESULT_URL=http://localhost:4200/bank/callback
ENABLEBANKING_COUNTRY=BG
ENABLEBANKING_SYNC_INTERVAL=6h
# Generate with: openssl rand -base64 32
ENABLEBANKING_ENCRYPTION_KEY=
SYNCWORKER_PORT=8081
